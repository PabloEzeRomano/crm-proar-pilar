{
  "private": true,
  "workspaces": [
    "apps/*",
    "packages/*"
  ],
  "scripts": {
    "proar": "yarn workspace @crm/proar start",
    "proar:web": "yarn workspace @crm/proar web",
    "proar:android": "yarn workspace @crm/proar android",
    "proar:ios": "yarn workspace @crm/proar ios",
    "proar:build:web": "yarn workspace @crm/proar build:web",
    "proar:lint": "yarn workspace @crm/proar lint",
    "sensei": "yarn workspace @crm/sensei start",
    "sensei:web": "yarn workspace @crm/sensei web",
    "sensei:build:web": "yarn workspace @crm/sensei build:web",
    "sensei:lint": "yarn workspace @crm/sensei lint",
    "lint": "yarn workspace @crm/proar lint && yarn workspace @crm/sensei lint"
  },
  "dependencies": {
    "@expo-google-fonts/dm-sans": "^0.4.2",
    "@react-native-async-storage/async-storage": "2.2.0",
    "@supabase/supabase-js": "^2.98.0",
    "dayjs": "^1.11.19",
    "expo": "55.0.5",
    "expo-constants": "^55.0.7",
    "expo-font": "^55.0.6",
    "expo-linking": "^55.0.7",
    "expo-router": "55.0.4",
    "expo-secure-store": "^55.0.8",
    "expo-status-bar": "^55.0.4",
    "react": "19.2.0",
    "react-dom": "19.2.0",
    "react-native": "0.83.2",
    "react-native-safe-area-context": "5.6.2",
    "react-native-screens": "4.23.0",
    "react-native-web": "^0.21.0",
    "zod": "^4.3.6",
    "zustand": "^5.0.11"
  },
  "devDependencies": {
    "@types/react": "^19.2.14",
    "babel-plugin-transform-import-meta": "^2.3.3",
    "typescript": "~5.9.2"
  }
}
